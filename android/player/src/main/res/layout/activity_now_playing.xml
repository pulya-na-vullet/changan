<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_solid"
    android:orientation="vertical"
    android:padding="20dp">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerCrop"
            android:background="@color/card"
            android:contentDescription="@string/now_playing" />

        <TextView
            android:id="@+id/track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold"
            android:maxLines="3" />

        <TextView
            android:id="@+id/folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:maxLines="2" />

        <com.changanhub.player.GlFogView
            android:id="@+id/gl_fog"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <com.changanhub.player.VisualizerView
            android:id="@+id/viz"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="16dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/viz_modes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <SeekBar
            android:id="@+id/seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_shuffle"
                android:layout_width="72dp"
                android:layout_height="64dp"
                android:background="@color/card"
                android:text="⇄"
                android:textSize="18sp"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/btn_prev"
                android:layout_width="88dp"
                android:layout_height="72dp"
                android:layout_marginStart="8dp"
                android:background="@color/card"
                android:text="⏮"
                android:textSize="22sp"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/btn_play"
                android:layout_width="120dp"
                android:layout_height="72dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@color/accent"
                android:text="▶"
                android:textSize="26sp"
                android:textColor="@color/bg_solid" />

            <Button
                android:id="@+id/btn_next"
                android:layout_width="88dp"
                android:layout_height="72dp"
                android:background="@color/card"
                android:text="⏭"
                android:textSize="22sp"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/btn_repeat"
                android:layout_width="72dp"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:background="@color/card"
                android:text="∞"
                android:textSize="18sp"
                android:textColor="@color/text" />
        </LinearLayout>
</LinearLayout>
