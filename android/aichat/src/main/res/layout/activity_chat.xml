<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_solid">

    <LinearLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/panel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/accent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tts_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tts_on"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

            <Switch
                android:id="@+id/tts_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_chat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_chat"
                android:textColor="@color/bg_solid"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@color/accent" />

            <TextView
                android:id="@+id/tab_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="@string/tab_settings"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@color/tab_off" />

            <TextView
                android:id="@+id/tab_history"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="@string/tab_history"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@color/tab_off" />

            <TextView
                android:id="@+id/tab_voice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="@string/tab_voice"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@color/tab_off" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:id="@+id/page_chat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/prompts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <ListView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="6dp"
                    android:stackFromBottom="true"
                    android:transcriptMode="alwaysScroll" />

                <TextView
                    android:id="@+id/empty"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/empty"
                    android:textColor="@color/muted"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:maxLines="2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <EditText
                        android:id="@+id/input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/card"
                        android:hint="@string/hint"
                        android:textColor="@color/text"
                        android:textColorHint="@color/muted"
                        android:textSize="16sp"
                        android:minHeight="52dp"
                        android:padding="10dp"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="4" />

                    <Button
                        android:id="@+id/btn_mic"
                        android:layout_width="56dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="6dp"
                        android:background="@color/tab_off"
                        android:text="🎙"
                        android:textSize="16sp"
                        android:textColor="@color/text" />

                    <Button
                        android:id="@+id/btn_stop"
                        android:layout_width="56dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="6dp"
                        android:background="@color/tab_off"
                        android:text="■"
                        android:textSize="16sp"
                        android:textColor="@color/danger" />

                    <Button
                        android:id="@+id/btn_send"
                        android:layout_width="96dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="6dp"
                        android:background="@color/accent"
                        android:text="@string/send"
                        android:textColor="@color/bg_solid"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/page_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/settings_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/page_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_new_chat"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/card"
                        android:text="Новый"
                        android:textColor="@color/text" />

                    <Button
                        android:id="@+id/btn_export"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@color/card"
                        android:text="Экспорт"
                        android:textColor="@color/text" />

                    <Button
                        android:id="@+id/btn_import"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@color/card"
                        android:text="Импорт"
                        android:textColor="@color/text" />
                </LinearLayout>

                <ListView
                    android:id="@+id/history_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/page_voice"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/voice_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp" />
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
