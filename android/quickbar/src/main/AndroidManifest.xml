<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.changanhub.quicklane"
    android:versionCode="4"
    android:versionName="1.3.0">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_logo"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:directBootAware="true">

        <activity
            android:name="com.changanhub.quickbar.MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.changanhub.quickbar.OverlayService"
            android:exported="true"
            android:enabled="true"
            android:stopWithTask="false"
            android:directBootAware="true" />

        <service
            android:name="com.changanhub.quickbar.KeepAliveJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true"
            android:directBootAware="true" />

        <receiver
            android:name="com.changanhub.quickbar.BootReceiver"
            android:exported="true"
            android:enabled="true"
            android:directBootAware="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.REBOOT" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.os.action.CHARGING" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
                <action android:name="android.intent.action.ACC_ON" />
                <action android:name="android.intent.action.ACTION_ACC_ON" />
                <action android:name="android.intent.action.ACTION_BOOT_IPO" />
                <action android:name="android.intent.action.BOOT_IPO" />
                <action android:name="mtk.intent.action.BOOT_IPO" />
                <action android:name="com.android.action.ACC_ON" />
                <action android:name="com.microntek.bootcheck" />
                <action android:name="autolink.intent.action.ACC_ON" />
                <action android:name="android.hardware.usb.action.USB_STATE" />
            </intent-filter>
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <data android:scheme="file" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.changanhub.quickbar.WatchdogReceiver"
            android:exported="false"
            android:enabled="true"
            android:directBootAware="true" />

        <receiver
            android:name="com.changanhub.quickbar.InstallResultReceiver"
            android:exported="false"
            android:enabled="true" />
    </application>
</manifest>
